{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://pulsepass.invalid/events/envelope.v1.schema.json",
 "title":"PulsePass event envelope v1",
 "type":"object",
 "required":["eventId","eventType","schemaVersion","aggregateType","aggregateId","aggregateVersion","occurredAt","producer","correlationId","payload"],
 "properties":{
  "eventId":{"type":"string","format":"uuid"},
  "eventType":{"type":"string","minLength":1},
  "schemaVersion":{"const":1},
  "aggregateType":{"type":"string","minLength":1},
  "aggregateId":{"type":"string","format":"uuid"},
  "aggregateVersion":{"type":"integer","minimum":0},
  "occurredAt":{"type":"string","format":"date-time"},
  "producer":{"type":"string","minLength":1},
  "correlationId":{"type":["string","null"],"format":"uuid"},
  "causationId":{"type":["string","null"],"format":"uuid"},
  "payload":{"type":"object"}
 }
}
