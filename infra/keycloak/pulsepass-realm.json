{
  "realm": "pulsepass",
  "enabled": true,
  "displayName": "PulsePass • Demonstração",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "Cliente"
      },
      {
        "name": "Organizador"
      },
      {
        "name": "Operador"
      },
      {
        "name": "Admin"
      },
      {
        "name": "ServiceOrders"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pulsepass-web",
      "enabled": true,
      "publicClient": false,
      "secret": "local-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/api/iam/callback",
        "http://localhost:5173/api/iam/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "pulsepass-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "pulsepass-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "orders-service",
      "enabled": true,
      "publicClient": false,
      "secret": "local-orders-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "pulsepass-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "pulsepass-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "roles",
        "service_account"
      ]
    }
  ],
  "users": [
    {
      "username": "cliente1",
      "enabled": true,
      "emailVerified": true,
      "email": "cliente1@pulsepass.invalid",
      "firstName": "Cliente1",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "PulsePass123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Cliente"
      ]
    },
    {
      "username": "cliente2",
      "enabled": true,
      "emailVerified": true,
      "email": "cliente2@pulsepass.invalid",
      "firstName": "Cliente2",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "PulsePass123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Cliente"
      ]
    },
    {
      "username": "organizador",
      "enabled": true,
      "emailVerified": true,
      "email": "organizador@pulsepass.invalid",
      "firstName": "Organizador",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "PulsePass123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Organizador"
      ]
    },
    {
      "username": "operador",
      "enabled": true,
      "emailVerified": true,
      "email": "operador@pulsepass.invalid",
      "firstName": "Operador",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "PulsePass123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "Operador"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
